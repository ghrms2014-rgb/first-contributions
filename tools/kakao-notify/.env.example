# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 로그인 > Redirect URI 에 등록한 주소와 반드시 똑같아야 합니다.
# 비워두면 http://localhost:5000/oauth 를 씁니다.
KAKAO_REDIRECT_URI=http://localhost:5000/oauth

# Client Secret을 켠 앱이라면 여기에. 안 켰으면 비워두세요.
# 콘솔에서 Client Secret 값을 복사해 넣습니다. 최근 만든 앱은 켜져 있을 수 있습니다.
KAKAO_CLIENT_SECRET=
